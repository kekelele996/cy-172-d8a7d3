# Compose project name, kept ASCII to avoid issues in Chinese paths.
COMPOSE_PROJECT_NAME=gb-172

# PostgreSQL settings used by the deployment database service.
DB_NAME=gb172
DB_USER=gb172
DB_PASSWORD=gb172_password
DB_ROOT_PASSWORD=gb172_root_password

# Reserved backend secret for consistent deployment shape.
JWT_SECRET=change_me_gb_172_password_toolbox

# Host port mappings.
FRONTEND_PORT=8272
BACKEND_PORT=3272
DB_PORT=5772
